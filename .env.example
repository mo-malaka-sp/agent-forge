# Shared sign-in. Defaults are agentforge / Forge-demo-17 when these are unset.
# AGENTFORGE_ADMIN_USERNAME=agentforge
# AGENTFORGE_ADMIN_PASSWORD=

# AWS environment preparation. CodeBuild reads secret references; do not put secret values here.
# ENVIRONMENT_TABLE_NAME=agentforge-environments
# ENVIRONMENT_CODEBUILD_PROJECT=agentforge-environment-runner
# ENVIRONMENT_RUNNER_DRY_RUN=1

# Optional — AgentForge auto-detects from request headers on Amplify
# AGENTFORGE_BASE_URL=https://main.d12mzah9vzl24s.amplifyapp.com

# SailPoint ISC credentials — preferred: Demo → ISC tenant connection (UI, no redeploy)
# Optional fallback for operators / CI:
# ISC_TENANT=your-tenant
# ISC_CLIENT_ID=your-client-id
# ISC_CLIENT_SECRET=your-client-secret

# Optional API defaults (UI overridable)
# ISC_API_VERSION=v2026
# ISC_DOMAIN=identitynow.com

# Web Services source IDs: Demo → ISC sources (saved server-side)

# Optional demo defaults for govern + enforce mode
# ISC_DEMO_AGENT_ID=agt_demo_aws_bedrock

# SAF event-bus and Datadog POC (/saf-poc)
# Reuses the saved ISC tenant connection when SAF_* credentials are unset.
# SAF_API_BASE=https://your-tenant.api.identitynow-demo.com
# SAF_CLIENT_ID=
# SAF_CLIENT_SECRET=
# SAF_OWNER_ID=
# SAF_OWNER_NAME=
# SAF_NOTIFY_EMAIL=admin@example.com
# SAF_TRIGGER_NAME=CAEP Risk Level Change Events
# SAF_POC_TABLE_NAME=agentforge-saf-poc
# SAF_POC_WORKER_CALLBACK_URL=https://main.example.amplifyapp.com
# SAF_POC_WORKER_TOKEN=
# Asana test-drive automation. Connect it from /readonly-account after deploy.
# Asana POSTs section moves to /api/readonly-account/asana/webhook.
# ASANA_ACCESS_TOKEN is the personal access token for a member of the project.
# Optional overrides: ASANA_PROJECT_GID, ASANA_PROJECT_NAME, ASANA_READY_SECTION
# POST /api/readonly-account/asana/tick finishes an invitation the first call could not wait for.
# Header: x-agentforge-worker: <SAF_POC_WORKER_TOKEN>
# ASANA_ACCESS_TOKEN=
# DD_API_KEY=
# DD_APP_KEY=
# DATADOG_INTAKE_URL=https://http-intake.logs.datadoghq.com/api/v2/logs
# WEBHOOK_TOKEN=
# SailPoint fire-and-forget webhook: POST /webhooks/saf
# Header: x-saf-webhook-token: <WEBHOOK_TOKEN>
# Datadog Live Tail: source:sailpoint @evt.category:security
# Security Inbox: source:sailpoint @evt.category:security @evt.outcome:critical
# SSF_API_TOKEN=
