# Optional — AgentForge auto-detects from request headers on Amplify
# AGENTFORGE_BASE_URL=https://main.d12mzah9vzl24s.amplifyapp.com

# SailPoint ISC credentials — preferred: Demo → ISC tenant connection (UI, no redeploy)
# Optional fallback for operators / CI:
# ISC_TENANT=your-tenant
# ISC_CLIENT_ID=your-client-id
# ISC_CLIENT_SECRET=your-client-secret

# Optional API defaults (UI overridable)
# ISC_API_VERSION=v2026
# ISC_DOMAIN=identitynow.com

# Web Services source IDs: Demo → ISC sources (saved server-side)

# Optional demo defaults for govern + enforce mode
# ISC_DEMO_AGENT_ID=agt_demo_aws_bedrock

# SAF event-bus and Datadog POC (/saf-poc)
# Reuses the saved ISC tenant connection when SAF_* credentials are unset.
# SAF_API_BASE=https://your-tenant.api.identitynow-demo.com
# SAF_CLIENT_ID=
# SAF_CLIENT_SECRET=
# SAF_OWNER_ID=
# SAF_OWNER_NAME=
# SAF_NOTIFY_EMAIL=admin@example.com
# SAF_TRIGGER_NAME=CAEP Risk Level Change Events
# SAF_POC_TABLE_NAME=agentforge-saf-poc
# DD_API_KEY=
# DATADOG_INTAKE_URL=https://http-intake.logs.datadoghq.com/api/v2/logs
# WEBHOOK_TOKEN=
# SailPoint fire-and-forget webhook: POST /webhooks/saf
# Header: x-saf-webhook-token: <WEBHOOK_TOKEN>
# Datadog Live Tail: source:sailpoint
# Critical detection: source:sailpoint @risk_severity:critical
# SSF_API_TOKEN=
